message measurement {
 REQUIRED INT32 schema_version;
 REQUIRED BINARY project_id (UTF8);
 REQUIRED BINARY source_id (UTF8);
 REQUIRED BINARY record_id (UTF8);
 OPTIONAL BINARY client_batch_id (UTF8);
 REQUIRED INT64 received_unix_nano (INTEGER(64,false));
 REQUIRED INT64 client_created_unix_nano (INTEGER(64,false));
 REQUIRED BINARY profile (UTF8);
 REQUIRED INT32 resource_index;
 REQUIRED INT32 scope_index;
 REQUIRED INT32 metric_index;
 REQUIRED INT32 point_index;
 OPTIONAL BINARY host_id (UTF8);
 OPTIONAL BINARY boot_id (UTF8);
 OPTIONAL BINARY collection_scope (UTF8);
 OPTIONAL BINARY collection_source (UTF8);
 OPTIONAL BINARY epoch_id (UTF8);
 OPTIONAL INT64 process_pid;
 OPTIONAL BINARY process_namespace_id (UTF8);
 OPTIONAL BINARY process_incarnation_id (UTF8);
 REQUIRED BINARY scope_name (UTF8);
 REQUIRED BINARY scope_version (UTF8);
 REQUIRED BINARY metric_name (UTF8);
 REQUIRED BINARY metric_description (UTF8);
 REQUIRED BINARY unit (UTF8);
 REQUIRED BINARY metric_type (UTF8);
 REQUIRED INT32 temporality;
 REQUIRED BOOLEAN is_monotonic;
 REQUIRED INT64 time_unix_nano (INTEGER(64,false));
 REQUIRED INT64 start_time_unix_nano (INTEGER(64,false));
 REQUIRED INT64 flags (INTEGER(64,false));
 OPTIONAL INT64 value_int;
 OPTIONAL DOUBLE value_double;
 REQUIRED BINARY resource_attributes_json (UTF8);
 REQUIRED BINARY scope_attributes_json (UTF8);
 REQUIRED BINARY metric_metadata_json (UTF8);
 REQUIRED BINARY point_attributes_json (UTF8);
 REQUIRED BINARY resource_schema_url (UTF8);
 REQUIRED BINARY metric_schema_url (UTF8);
 REQUIRED BINARY resource_proto;
 REQUIRED BINARY scope_proto;
 REQUIRED BINARY point_proto;
}
