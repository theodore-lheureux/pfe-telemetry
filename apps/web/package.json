{
  "name": "@recount/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "bun .output/server/index.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "build": "vite build && bun build scripts/live-gateway.ts --target=bun --outfile=.output/live/index.mjs",
    "live": "bun scripts/live-gateway.ts",
    "typecheck": "bun scripts/compile-telemetry.ts && bun run --filter @recount/i18n compile && tsc --noEmit",
    "test": "bun scripts/compile-telemetry.ts && bun run --filter @recount/i18n compile && bun test tests/unit",
    "test:db": "bun scripts/compile-telemetry.ts && bun run --filter @recount/i18n compile && bun test --timeout 30000 tests/integration",
    "test:telemetry": "bun run --filter @recount/i18n compile && bun test --timeout 30000 tests/telemetry",
    "test:browser": "bun run --filter @recount/i18n compile && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@clickhouse/client": "1.24.1",
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@recount/i18n": "workspace:*",
    "@recount/transactional": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "0.23.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.15",
    "bowser": "2.15.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "es-toolkit": "1.53.1",
    "input-otp": "1.5.0",
    "kafkajs": "2.2.4",
    "lucide-react": "1.67.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "protobufjs": "8.8.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-json-view-lite": "2.5.0",
    "react-resizable-panels": "4.21.0",
    "recharts": "3.8.0",
    "uuid": "14.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-utils": "1.162.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "nitro": "3.0.261103-rc",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
