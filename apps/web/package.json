{
  "name": "@pfe/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "typecheck": "bun run --filter @pfe/i18n compile && tsc --noEmit",
    "test": "bun run --filter @pfe/i18n compile && bun test tests/unit",
    "test:db": "bun run --filter @pfe/i18n compile && bun test --timeout 30000 tests/integration",
    "test:telemetry": "bun run --filter @pfe/i18n compile && bun test --timeout 30000 tests/telemetry",
    "test:browser": "bun run --filter @pfe/i18n compile && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@clickhouse/client": "1.24.1",
    "@pfe/i18n": "workspace:*",
    "@pfe/transactional": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "es-toolkit": "1.53.1",
    "lucide-react": "1.67.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
