# Vite development server. Command-line --port overrides this setting.
WEB_PORT=3001

# Match the password configured in infra/application/.env.
DATABASE_URL=postgresql://pfe:CHANGE_ME@127.0.0.1:15432/pfe
DATABASE_POOL_MAX=10

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
AUTH_ALLOW_SIGN_UP=false

# Use a verified sender address and Resend SMTP credentials.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=
