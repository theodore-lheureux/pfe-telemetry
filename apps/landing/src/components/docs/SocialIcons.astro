---
// Starlight already links the logo to the home page.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { localePath } from "../../i18n";
import { strings } from "../../i18n/strings";

const lang = Astro.locals.starlightRoute.locale === "fr" ? "fr" : "en";
const t = strings[lang].nav;
const links = [
	{ href: localePath(lang, "/pricing/"), label: t.pricing },
	{ href: localePath(lang, "/changelog/"), label: t.changelog },
];
---

{
	links.map((link) => (
		<a href={link.href} class="site-link">
			{link.label}
		</a>
	))
}
<Default />

<style>
	.site-link {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
	}
	.site-link:hover {
		color: var(--sl-color-white);
	}
</style>
