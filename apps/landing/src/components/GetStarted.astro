---
import { type Lang, localePath } from "../i18n";
import { strings } from "../i18n/strings";
import { appHref, buttonClass } from "../lib/site";
import Container from "./Container.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].getStarted;
---

<section aria-labelledby="get-started" class="scroll-mt-14 border-t bg-card">
	<Container class="flex flex-col items-center py-24 text-center">
		<h2 id="get-started" class="font-medium text-[28px] tracking-tight">{t.title}</h2>
		<p class="mt-3 max-w-[46ch] text-base text-muted-foreground leading-relaxed">{t.text}</p>
		<div class="mt-8 flex flex-wrap justify-center gap-2">
			<a href={appHref(lang)} data-app-link data-signed-in-label={strings[lang].nav.openApp} class={buttonClass("primary")}>
				{t.signIn}
			</a>
			<a href={localePath(lang, "/docs/quick-start/")} class={buttonClass("outline")}>{t.quickStart}</a>
		</div>
	</Container>
</section>
