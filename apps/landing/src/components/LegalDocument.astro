---
import { getEntry, render } from "astro:content";
import type { Lang } from "../i18n";
import { strings } from "../i18n/strings";
import Page from "../layouts/Page.astro";

interface Props {
	lang: Lang;
	document: "privacy" | "terms";
}

const { lang, document } = Astro.props;
const t = strings[lang].legal;
const entry = await getEntry("legal", `${lang}/${document}`);
if (!entry) throw new Error(`Missing legal page ${lang}/${document}`);
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const format = new Intl.DateTimeFormat(lang === "fr" ? "fr-CA" : "en", {
	dateStyle: "long",
	timeZone: "UTC",
});
---

<Page
	lang={lang}
	title={entry.data.title}
	description={entry.data.description}
	heading={entry.data.title}
	intro={`${t.updated} ${format.format(entry.data.updated)}`}
>
	<nav aria-labelledby="contents" class="mb-12 rounded-md border bg-card p-5">
		<h2 id="contents" class="font-medium text-[13px] text-muted-foreground">{t.contents}</h2>
		<ol class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
			{
				sections.map((section) => (
					<li>
						<a href={`#${section.slug}`} class="text-foreground underline-offset-2 hover:text-primary hover:underline">
							{section.text}
						</a>
					</li>
				))
			}
		</ol>
	</nav>
	<div class="legal prose" data-section-link={t.sectionLink}>
		<Content />
	</div>
</Page>

<style>
	.legal :global(h2) {
		scroll-margin-top: 5rem;
	}
	.legal :global(h2 > a) {
		color: inherit;
		text-decoration: none;
	}
	.legal :global(h2 > a::after) {
		content: "#";
		margin-left: 0.4em;
		color: var(--muted-foreground);
		opacity: 0;
		transition: opacity 150ms;
	}
	.legal :global(h2 > a:hover::after),
	.legal :global(h2 > a:focus-visible::after) {
		opacity: 1;
	}
</style>

<script>
	for (const container of document.querySelectorAll<HTMLElement>(".legal[data-section-link]")) {
		for (const heading of container.querySelectorAll<HTMLHeadingElement>("h2[id]")) {
			const link = document.createElement("a");
			link.href = `#${heading.id}`;
			link.title = container.dataset.sectionLink ?? "";
			link.append(...heading.childNodes);
			heading.append(link);
		}
	}
</script>
