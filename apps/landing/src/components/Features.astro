---
import { type Lang, localePath } from "../i18n";
import { strings } from "../i18n/strings";
import { features } from "../lib/site";
import Container from "./Container.astro";
import Icon from "./Icon.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].features;
const link = "font-medium text-primary underline-offset-2 hover:underline";
---

<section aria-labelledby="features" class="scroll-mt-14 border-b">
	<Container class="grid gap-12 py-24 lg:grid-cols-[1fr_2fr]">
		<div class="lg:sticky lg:top-24 lg:self-start">
			<h2 id="features" class="font-medium text-[28px] tracking-tight">{t.title}</h2>
			<p class="mt-3 max-w-[36ch] text-base text-muted-foreground leading-relaxed">{t.intro}</p>
			<div class="mt-6 flex flex-col items-start gap-2">
				<a href={localePath(lang, "/docs/")} class={link}>{t.docsLink} →</a>
				<a href={localePath(lang, "/pricing/")} class={link}>{t.pricingLink} →</a>
			</div>
		</div>
		<div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
			{
				features.map(({ key, icon }) => (
					<div class="flex gap-4">
						<span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-accent text-accent-foreground">
							<Icon svg={icon} class="size-[18px]" />
						</span>
						<div>
							<h3 class="font-medium">{t.items[key].title}</h3>
							<p class="mt-1 text-muted-foreground leading-relaxed">{t.items[key].text}</p>
						</div>
					</div>
				))
			}
		</div>
	</Container>
</section>
