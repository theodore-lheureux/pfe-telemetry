---
import type { Lang } from "../i18n";
import { strings } from "../i18n/strings";
import { featureIcons } from "../lib/site";
import Container from "./Container.astro";
import Icon from "./Icon.astro";

interface Props {
	lang: Lang;
}

const t = strings[Astro.props.lang].features;
---

<section aria-labelledby="features" class="scroll-mt-14 border-b">
	<Container class="grid gap-12 py-24 lg:grid-cols-[1fr_2fr]">
		<div class="lg:sticky lg:top-24 lg:self-start">
			<h2 id="features" class="font-medium text-[28px] tracking-tight">{t.title}</h2>
			<p class="mt-3 max-w-[36ch] text-base text-muted-foreground leading-relaxed">{t.intro}</p>
		</div>
		<div class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
			{
				t.items.map((f, i) => (
					<div class="flex gap-4">
						<span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-accent text-accent-foreground">
							<Icon svg={featureIcons[i]} class="size-[18px]" />
						</span>
						<div>
							<h3 class="font-medium">{f.title}</h3>
							<p class="mt-1 text-muted-foreground leading-relaxed">{f.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</Container>
</section>
