---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { buttonClass } from "../lib/site";
---

<Layout title="Page not found · Recount" description="This page doesn't exist." lang="en" translated={false}>
	<Header lang="en" />
	<main class="mx-auto flex min-h-[calc(100svh-3.5rem-200px)] max-w-[1240px] flex-col items-start justify-center px-4 py-24 sm:px-6 lg:px-8">
		<p class="font-medium text-primary">404</p>
		<h1 class="mt-2 font-medium text-4xl tracking-tight">Page not found</h1>
		<p class="mt-4 max-w-[48ch] text-base text-muted-foreground leading-relaxed">
			The page you were looking for doesn't exist or has moved.
		</p>
		<p lang="fr" class="mt-2 max-w-[48ch] text-muted-foreground leading-relaxed">
			Cette page n’existe pas ou a été déplacée. <a href="/fr/" class="text-primary underline underline-offset-2">Retour à l’accueil</a>
		</p>
		<div class="mt-8 flex flex-wrap gap-2">
			<a href="/" class={buttonClass("primary")}>Back to home</a>
			<a href="/docs/" class={buttonClass("outline")}>Read the docs</a>
		</div>
	</main>
	<Footer lang="en" translated={false} />
</Layout>
