---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { Lang } from "../i18n";
import { strings } from "../i18n/strings";
import Layout from "./Layout.astro";

interface Props {
	lang: Lang;
	title: string;
	description: string;
	heading: string;
	intro?: string;
	/** Wider column for pages with cards. */
	wide?: boolean;
}

const { lang, title, description, heading, intro, wide = false } = Astro.props;
---

<Layout title={`${title} · Recount`} description={description} lang={lang}>
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-card focus:px-3 focus:py-2"
	>
		{strings[lang].nav.skip}
	</a>
	<Header lang={lang} />
	<main id="main" class:list={["mx-auto w-full px-4 py-20 sm:px-6", wide ? "max-w-[880px]" : "max-w-[720px]"]}>
		<h1 class="font-medium text-4xl tracking-tight">{heading}</h1>
		{intro && <p class="mt-4 max-w-[60ch] text-base text-muted-foreground leading-relaxed">{intro}</p>}
		<div class="mt-12">
			<slot />
		</div>
	</main>
	<Footer lang={lang} />
</Layout>
