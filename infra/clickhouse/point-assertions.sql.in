SELECT throwIf(count() != 30, 'ordinary rows still contain retries') FROM __POINTS_TABLE__;
SELECT throwIf(count() != 15, 'full original sample identity must retain distinct points') FROM __POINTS_TABLE__ FINAL;
SELECT throwIf(min(int_value) != toInt64('-9223372036854775808') OR max(int_value) != toInt64('9223372036854775807'), 'Int64 precision') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'integer.extremes';
SELECT throwIf(max(time_unix_nano) != toUInt64('18446744073709551615'), 'UInt64 nanoseconds') FROM __POINTS_TABLE__ FINAL;
SELECT throwIf(count() != 1, 'missing scalar must not become zero') FROM __POINTS_TABLE__ FINAL WHERE flags = 1 AND int_value IS NULL AND double_value IS NULL;
SELECT throwIf(count() != 1, 'histogram optionality and buckets') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'distribution' AND count = 3 AND sum IS NULL AND min IS NULL AND max = 9 AND explicit_bounds = [0.5] AND bucket_counts = [toUInt64(1),toUInt64(2)];
SELECT throwIf(count() != 1, 'full UInt64 histogram count') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'distribution' AND count = toUInt64('18446744073709551615') AND bucket_counts = [];
SELECT throwIf(count() != 1, 'exponential histogram structure') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'exponential' AND scale = -7 AND zero_count = 1 AND zero_threshold = 0.001 AND positive_offset = -2 AND positive_counts = [toUInt64(2)] AND negative_offset = 4 AND negative_counts = [toUInt64(3)];
SELECT throwIf(count() != 1, 'present empty versus absent buckets') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'exponential' AND positive_offset = 0 AND positive_counts = [] AND negative_offset IS NULL AND negative_counts = [] AND sum IS NULL;
SELECT throwIf(count() != 1, 'summary structure') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'summary' AND count = 2 AND sum = -1 AND quantiles = [0.,1.] AND quantile_values = [-2.,1.];
SELECT throwIf(count() != 1, 'Int64 attributes remain typed') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'arbitrary.authorized.metric' AND flags = 0 AND arrayExists(a -> a.1 = '/exact' AND a.2 = 3 AND a.4 = toInt64('9223372036854775807'), point_attributes);
SELECT throwIf(count() != 1, 'nested attributes remain queryable') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'arbitrary.authorized.metric' AND flags = 0 AND arrayExists(a -> a.1 = '/nested~1a~0b/min' AND a.4 = toInt64('-9223372036854775808'), point_attributes);
SELECT throwIf(count() != 1, 'native GPU timestamp') FROM __POINTS_TABLE__ FINAL WHERE resource_id = 'gpu-a' AND time_unix_nano = toUInt64('1780000000000000123');
SELECT throwIf(count() != 2, 'gateway sensor resources do not need host or topology') FROM __POINTS_TABLE__ FINAL WHERE project_id = 'project-a' AND source_id = 'source-a' AND resource_kind = 8 AND host_id IS NULL;
SELECT throwIf(count() != 2, 'counter continuity segments') FROM (SELECT DISTINCT stream_id, continuity FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'counter');
SELECT throwIf(count() != 1, 'project/resource/metric/time filter') FROM __POINTS_TABLE__ FINAL
WHERE project_id = 'project-a' AND resource_id = 'sensor-a' AND metric_name = 'sensor.temperature'
  AND time_unix_nano >= toUInt64('1780000000000000300') AND time_unix_nano < toUInt64('1780000000000000301');
SELECT throwIf(count() != 0, 'cross-project filter') FROM __POINTS_TABLE__ FINAL WHERE project_id = 'other-project';
SELECT throwIf(sum(double_value) != -25., 'fixture must expose duplicate-sensitive sum') FROM __POINTS_TABLE__ WHERE metric_name = 'arbitrary.authorized.metric' AND flags = 0;
SELECT throwIf(sum(double_value) != -12.5, 'logical uniqueness before calculation') FROM __POINTS_TABLE__ FINAL WHERE metric_name = 'arbitrary.authorized.metric' AND flags = 0;
SELECT throwIf(count() != 0, 'partition must be event-derived') FROM __POINTS_TABLE__ FINAL WHERE event_day != intDiv(time_unix_nano,toUInt64('86400000000000'));
SELECT throwIf(count()!=1,'nullable present zero integer') FROM __POINTS_TABLE__ FINAL WHERE resource_id='gpu-a' AND arrayExists(a->a.path='/zero-int' AND a.int_value=0 AND a.double_value IS NULL,resource_attributes);
SELECT throwIf(count()!=1,'nullable present zero double') FROM __POINTS_TABLE__ FINAL WHERE resource_id='gpu-a' AND arrayExists(a->a.path='/zero-double' AND a.double_value=0 AND a.int_value IS NULL,resource_attributes);
SELECT throwIf(count()!=1,'nullable present false') FROM __POINTS_TABLE__ FINAL WHERE resource_id='gpu-a' AND arrayExists(a->a.path='/false' AND a.bool_value=0 AND a.string_value IS NULL,resource_attributes);
SELECT throwIf(count()!=1,'nullable present empty bytes and string') FROM __POINTS_TABLE__ FINAL WHERE resource_id='gpu-a' AND arrayExists(a->a.path='/empty-string' AND a.string_value='',resource_attributes) AND arrayExists(a->a.path='/empty-bytes' AND a.bytes_value='',resource_attributes);
SELECT throwIf(count()!=1,'native binary attribute') FROM __POINTS_TABLE__ FINAL WHERE metric_name='arbitrary.authorized.metric' AND flags=0 AND arrayExists(a->a.path='/bytes' AND hex(a.bytes_value)='00FF',point_attributes);
