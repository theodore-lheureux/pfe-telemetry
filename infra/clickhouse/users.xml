<clickhouse>
  <profiles>
    <telemetry_read>
      <readonly>2</readonly>
      <max_concurrent_queries_for_user>2</max_concurrent_queries_for_user>
      <max_execution_time>6</max_execution_time>
      <max_memory_usage>268435456</max_memory_usage>
      <max_threads>1</max_threads>
      <constraints>
        <max_execution_time><min>1</min><max>6</max></max_execution_time>
        <max_memory_usage><min>1</min><max>268435456</max></max_memory_usage>
        <max_threads><min>1</min><max>1</max></max_threads>
        <max_concurrent_queries_for_user><min>1</min><max>2</max></max_concurrent_queries_for_user>
      </constraints>
    </telemetry_read>
  </profiles>
  <users>
    <telemetry_reader>
      <profile>telemetry_read</profile>
      <password from_env="CLICKHOUSE_READER_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <grants>
        <query>GRANT SELECT ON telemetry.metric_points</query>
      </grants>
    </telemetry_reader>
  </users>
</clickhouse>
