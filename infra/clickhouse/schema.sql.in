CREATE DATABASE IF NOT EXISTS __DATABASE__;

CREATE TABLE __CREATE_GUARD____DATABASE__.dead_letter_deliveries
(
    project_id String,
    source_id String,
    raw_topic String,
    raw_partition UInt32,
    raw_offset UInt64,
    received_unix_nano UInt64,
    received_from_broker Bool,
    rejected_unix_nano UInt64,
    reason LowCardinality(String),
    stage LowCardinality(String),
    normalizer_build String,
    raw_max_bytes UInt64,
    normalized_record_max_bytes UInt64,
    normalized_batch_max_bytes UInt64,
    normalized_broker_max_bytes UInt64
)
ENGINE = ReplacingMergeTree(rejected_unix_nano)
ORDER BY (project_id, received_unix_nano, raw_topic, raw_partition, raw_offset)
TTL toDateTime(intDiv(rejected_unix_nano, 1000000000)) + INTERVAL 7 DAY
SETTINGS fsync_after_insert = 0, fsync_part_directory = 1;

CREATE VIEW __CREATE_GUARD____DATABASE__.project_rejected_deliveries
DEFINER = CURRENT_USER SQL SECURITY DEFINER AS
SELECT project_id, source_id, raw_topic, raw_partition, raw_offset,
       received_unix_nano, rejected_unix_nano, reason
FROM __DATABASE__.dead_letter_deliveries
WHERE notEmpty(project_id)
    AND rejected_unix_nano >= toUInt64(toUnixTimestamp(now() - INTERVAL 7 DAY)) * 1000000000;

CREATE TABLE __CREATE_GUARD____DATABASE__.dead_letter_kafka
AS __DATABASE__.dead_letter_deliveries
ENGINE = Kafka
SETTINGS
    kafka_broker_list = '__KAFKA_BOOTSTRAP__',
    kafka_topic_list = '__DEAD_LETTER_TOPIC__',
    kafka_group_name = '__DEAD_LETTER_GROUP__',
    kafka_format = 'JSONEachRow',
    kafka_num_consumers = 1,
    kafka_max_block_size = 64;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_dead_letter_deliveries
TO __DATABASE__.dead_letter_deliveries AS SELECT *
FROM __DATABASE__.dead_letter_kafka;

CREATE TABLE __CREATE_GUARD____DATABASE__.metric_points
(
__POINT_COLUMNS__
)
ENGINE = ReplacingMergeTree(raw_offset)
PARTITION BY event_day
PRIMARY KEY (project_id, metric_name, series_id, time_unix_nano)
ORDER BY (project_id, metric_name, series_id, time_unix_nano, stream_id)
SETTINGS index_granularity = 1024, merge_max_block_size = 8192, merge_max_block_size_bytes = 10485760,
    fsync_after_insert = 0, fsync_part_directory = 1;

-- Non-key dimensions are immutable for a storage series_id. Only the bounds aggregate.
-- Side tables inherit the server merge block caps: their dimension/evidence rows
-- are wider, and they do not have the point table's throughput target.
CREATE TABLE __CREATE_GUARD____DATABASE__.metric_series
(
__SERIES_COLUMNS__
)
ENGINE = AggregatingMergeTree
ORDER BY (project_id, metric_name, series_id)
SETTINGS allow_dimensions_outside_sorting_key = 1, fsync_after_insert = 0, fsync_part_directory = 1;

CREATE TABLE __CREATE_GUARD____DATABASE__.deliveries
(
__DELIVERY_COLUMNS__
)
ENGINE = ReplacingMergeTree
ORDER BY (project_id, source_id, raw_partition, raw_offset)
SETTINGS fsync_after_insert = 0, fsync_part_directory = 1;

CREATE TABLE __CREATE_GUARD____DATABASE__.delivery_contexts
(
__DELIVERY_CONTEXT_COLUMNS__
)
ENGINE = ReplacingMergeTree
ORDER BY (project_id, source_id, delivery_context_id)
SETTINGS fsync_after_insert = 0, fsync_part_directory = 1;

CREATE TABLE __CREATE_GUARD____DATABASE__.metric_streams
(
__STREAM_COLUMNS__
)
ENGINE = ReplacingMergeTree
ORDER BY (project_id, stream_id)
SETTINGS fsync_after_insert = 0, fsync_part_directory = 1;

-- Due series and streams carry metadata on their first frame in the packet.
CREATE TABLE __CREATE_GUARD____DATABASE__.normalized_kafka
(
__KAFKA_COLUMNS__
)
ENGINE = Kafka
SETTINGS
__KAFKA_SETTINGS__
    kafka_num_consumers = __RECENT_CONSUMERS__,
    kafka_topic_list = '__NORMALIZED_TOPIC__',
    kafka_format = 'Protobuf',
    kafka_group_name = '__CONSUMER_GROUP__',
    kafka_max_block_size = __RECENT_BLOCK_ROWS__,
    kafka_poll_max_batch_size = __RECENT_POLL_MESSAGES__,
    kafka_poll_timeout_ms = __POLL_MS__,
    kafka_flush_interval_ms = __RECENT_FLUSH_MS__;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_metric_series
TO __DATABASE__.metric_series AS SELECT __SERIES_SELECT__ FROM __DATABASE__.normalized_kafka AS src
WHERE last_seen_unix_nano != 0;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_metric_points
TO __DATABASE__.metric_points AS SELECT __POINT_SELECT__ FROM __DATABASE__.normalized_kafka AS src;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_deliveries
TO __DATABASE__.deliveries AS SELECT project_id, source_id, raw_partition, raw_offset, received_unix_nano, min_event_unix_nano, max_event_unix_nano, delivery_request, delivery_context_id FROM __DATABASE__.normalized_kafka
WHERE notEmpty(delivery_request);

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_delivery_contexts
TO __DATABASE__.delivery_contexts AS SELECT project_id, source_id, delivery_context_id, delivery_context
FROM __DATABASE__.normalized_kafka WHERE notEmpty(delivery_context);

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_metric_streams
TO __DATABASE__.metric_streams AS SELECT project_id, stream_id, resource_continuity, point_continuity
FROM __DATABASE__.normalized_kafka WHERE stream_evidence != 0;

-- Late packets are singletons so a poll can't exceed the event-day partition guard.
CREATE TABLE __CREATE_GUARD____DATABASE__.late_kafka
(
__KAFKA_COLUMNS__
)
ENGINE = Kafka
SETTINGS
__KAFKA_SETTINGS__
    kafka_num_consumers = 1,
    kafka_topic_list = '__LATE_TOPIC__',
    kafka_format = 'ProtobufSingle',
    kafka_group_name = '__LATE_CONSUMER_GROUP__',
    kafka_max_block_size = __BLOCK_ROWS__,
    kafka_poll_max_batch_size = __POLL_MESSAGES__,
    kafka_poll_timeout_ms = __POLL_MS__,
    kafka_flush_interval_ms = __FLUSH_MS__;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_late_metric_series
TO __DATABASE__.metric_series AS SELECT __SERIES_SELECT__ FROM __DATABASE__.late_kafka AS src
WHERE last_seen_unix_nano != 0;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_late_metric_points
TO __DATABASE__.metric_points AS SELECT __POINT_SELECT__ FROM __DATABASE__.late_kafka AS src;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_late_deliveries
TO __DATABASE__.deliveries AS SELECT project_id, source_id, raw_partition, raw_offset, received_unix_nano, min_event_unix_nano, max_event_unix_nano, delivery_request, delivery_context_id FROM __DATABASE__.late_kafka
WHERE notEmpty(delivery_request);

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_late_delivery_contexts
TO __DATABASE__.delivery_contexts AS SELECT project_id, source_id, delivery_context_id, delivery_context
FROM __DATABASE__.late_kafka WHERE notEmpty(delivery_context);

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_late_metric_streams
TO __DATABASE__.metric_streams AS SELECT project_id, stream_id, resource_continuity, point_continuity
FROM __DATABASE__.late_kafka WHERE stream_evidence != 0;
