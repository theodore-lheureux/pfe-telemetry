CREATE DATABASE IF NOT EXISTS telemetry;

CREATE TABLE IF NOT EXISTS telemetry.metric_points
(
__ANALYTICAL_COLUMNS__
)
ENGINE = ReplacingMergeTree
PARTITION BY event_day
ORDER BY (project_id, source_id, resource_id, metric_name, time_unix_nano, sample_id)
SETTINGS index_granularity = 256, fsync_after_insert = 1, fsync_part_directory = 1;

CREATE TABLE IF NOT EXISTS telemetry.normalized_kafka
(
__ANALYTICAL_COLUMNS__
)
ENGINE = Kafka
SETTINGS
    kafka_broker_list = '__KAFKA_BOOTSTRAP__',
    kafka_topic_list = '__NORMALIZED_TOPIC__',
    kafka_group_name = 'recount-clickhouse',
    kafka_format = 'ProtobufSingle',
    kafka_schema = 'recount.proto:AnalyticalPoint',
    format_protobuf_use_autogenerated_schema = 0,
    kafka_schema_registry_skip_bytes = 0,
    kafka_skip_broken_messages = 0,
    kafka_handle_error_mode = 'default',
    input_format_allow_errors_num = 0,
    input_format_allow_errors_ratio = 0,
    kafka_commit_every_batch = 0,
    kafka_commit_on_select = 0,
    kafka_num_consumers = 1,
    kafka_thread_per_consumer = 1,
    kafka_max_block_size = 1,
    kafka_poll_max_batch_size = 1,
    kafka_poll_timeout_ms = __POLL_MS__,
    kafka_flush_interval_ms = __FLUSH_MS__;

CREATE MATERIALIZED VIEW IF NOT EXISTS telemetry.ingest_metric_points
TO telemetry.metric_points AS SELECT * FROM telemetry.normalized_kafka;
