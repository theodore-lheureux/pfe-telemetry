CREATE DATABASE IF NOT EXISTS __DATABASE__;

CREATE TABLE __CREATE_GUARD____DATABASE__.metric_points
(
__ANALYTICAL_COLUMNS__
)
ENGINE = ReplacingMergeTree
PARTITION BY event_day
ORDER BY (project_id, source_id, resource_id, metric_name, time_unix_nano, sample_id)
SETTINGS index_granularity = 256, fsync_after_insert = 1, fsync_part_directory = 1;

CREATE TABLE __CREATE_GUARD____DATABASE__.normalized_kafka
(
__ANALYTICAL_COLUMNS__
)
ENGINE = Kafka
SETTINGS
    kafka_broker_list = '__KAFKA_BOOTSTRAP__',
    kafka_topic_list = '__NORMALIZED_TOPIC__',
    kafka_group_name = '__CONSUMER_GROUP__',
    kafka_format = 'ProtobufSingle',
    kafka_schema = 'recount.proto:AnalyticalPoint',
    format_protobuf_use_autogenerated_schema = 0,
    kafka_schema_registry_skip_bytes = 0,
    kafka_skip_broken_messages = 0,
    kafka_handle_error_mode = 'default',
    input_format_allow_errors_num = 0,
    input_format_allow_errors_ratio = 0,
    kafka_commit_every_batch = 0,
    kafka_commit_on_select = 0,
    kafka_num_consumers = 1,
    kafka_thread_per_consumer = 1,
    kafka_max_block_size = __BLOCK_ROWS__,
    kafka_poll_max_batch_size = __POLL_MESSAGES__,
    kafka_poll_timeout_ms = __POLL_MS__,
    kafka_flush_interval_ms = __FLUSH_MS__;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.ingest_metric_points
TO __DATABASE__.metric_points AS SELECT * FROM __DATABASE__.normalized_kafka;

-- Discovery catalog: which metrics and attributes each project has sent. Materialized
-- views aggregate as points arrive, so discovery adds no ingestion write path.
CREATE TABLE __CREATE_GUARD____DATABASE__.metric_definitions
(
    project_id String,
    metric_name String,
    metric_kind UInt8,
    temporality UInt8,
    monotonic_state UInt8,
    unit String,
    description SimpleAggregateFunction(anyLast, String),
    first_seen_unix_nano SimpleAggregateFunction(min, UInt64),
    last_seen_unix_nano SimpleAggregateFunction(max, UInt64)
)
ENGINE = AggregatingMergeTree
ORDER BY (project_id, metric_name, metric_kind, temporality, monotonic_state, unit);

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.discover_metric_definitions
TO __DATABASE__.metric_definitions AS
SELECT
    project_id,
    metric_name,
    metric_kind,
    temporality,
    ifNull(monotonic, 2) AS monotonic_state,
    unit,
    anyLast(description) AS description,
    min(time_unix_nano) AS first_seen_unix_nano,
    max(time_unix_nano) AS last_seen_unix_nano
FROM __DATABASE__.metric_points
GROUP BY project_id, metric_name, metric_kind, temporality, monotonic_state, unit;

CREATE TABLE __CREATE_GUARD____DATABASE__.attribute_definitions
(
    project_id String,
    metric_name String,
    scope LowCardinality(String),
    attribute_key String,
    value_kind UInt8,
    last_seen_unix_nano SimpleAggregateFunction(max, UInt64)
)
ENGINE = AggregatingMergeTree
ORDER BY (project_id, metric_name, scope, attribute_key, value_kind);

-- Only top-level scalar attributes. Continuity markers are internal and never offered.
CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.discover_point_attributes
TO __DATABASE__.attribute_definitions AS
SELECT
    project_id,
    metric_name,
    'point' AS scope,
    substring(attribute.path, 2) AS attribute_key,
    attribute.kind AS value_kind,
    max(time_unix_nano) AS last_seen_unix_nano
FROM __DATABASE__.metric_points
ARRAY JOIN point_attributes AS attribute
WHERE attribute.kind BETWEEN 2 AND 6
    AND position(substring(attribute.path, 2), '/') = 0
    AND attribute.path != '/recount.counter.segment_id'
GROUP BY project_id, metric_name, scope, attribute_key, value_kind;

CREATE MATERIALIZED VIEW __CREATE_GUARD____DATABASE__.discover_resource_attributes
TO __DATABASE__.attribute_definitions AS
SELECT
    project_id,
    metric_name,
    'resource' AS scope,
    substring(attribute.path, 2) AS attribute_key,
    attribute.kind AS value_kind,
    max(time_unix_nano) AS last_seen_unix_nano
FROM __DATABASE__.metric_points
ARRAY JOIN resource_attributes AS attribute
WHERE attribute.kind BETWEEN 2 AND 6
    AND position(substring(attribute.path, 2), '/') = 0
    AND attribute.path NOT IN ('/recount.host.boot_id', '/recount.collection.epoch_id')
GROUP BY project_id, metric_name, scope, attribute_key, value_kind;
