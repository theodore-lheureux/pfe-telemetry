CREATE TABLE __DATABASE__.execution_participants
(
__PARTICIPANT_COLUMNS__
)
ENGINE = ReplacingMergeTree(revision)
PARTITION BY cityHash64(project_id) % 16
ORDER BY (project_id, execution_key, node_id, fact_id)
SETTINGS index_granularity = 256, fsync_after_insert = 1, fsync_part_directory = 1;

CREATE TABLE __DATABASE__.participants_kafka
(
__PARTICIPANT_COLUMNS__
)
ENGINE = Kafka
SETTINGS
    kafka_broker_list = '__KAFKA_BOOTSTRAP__',
    kafka_topic_list = '__PARTICIPANT_TOPIC__',
    kafka_group_name = '__PARTICIPANT_GROUP__',
    kafka_format = 'ProtobufSingle',
    kafka_schema = 'executions.proto:AnalyticalParticipant',
    format_protobuf_use_autogenerated_schema = 0,
    kafka_schema_registry_skip_bytes = 0,
    kafka_skip_broken_messages = 0,
    kafka_handle_error_mode = 'default',
    input_format_allow_errors_num = 0,
    input_format_allow_errors_ratio = 0,
    kafka_commit_every_batch = 0,
    kafka_commit_on_select = 0,
    kafka_num_consumers = 1,
    kafka_thread_per_consumer = 1,
    kafka_max_block_size = __PARTICIPANT_BLOCK_ROWS__,
    kafka_poll_max_batch_size = __PARTICIPANT_POLL_MESSAGES__,
    kafka_poll_timeout_ms = 100,
    kafka_flush_interval_ms = 2000;

CREATE MATERIALIZED VIEW __DATABASE__.ingest_execution_participants
TO __DATABASE__.execution_participants AS SELECT * FROM __DATABASE__.participants_kafka;
