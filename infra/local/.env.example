# Development configuration only. Replace passwords privately before starting.
POSTGRES_PASSWORD=replace-local-application-password
DATABASE_URL=postgresql://recount:replace-local-application-password@postgres:5432/recount
RECOUNT_INGESTION_DATABASE_URL=postgresql://recount_ingestion:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/recount?sslmode=disable
CLICKHOUSE_ADMIN_PASSWORD=replace-local-admin-password
CLICKHOUSE_READER_PASSWORD=replace-local-reader-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
RECOUNT_AUTH_ALLOW_SIGN_UP=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=

RECOUNT_POSTGRES_PORT=15432
RECOUNT_INGESTION_PORT=14317
# Loopback Kafka listener for host-native clients.
RECOUNT_KAFKA_HOST_PORT=19092
RECOUNT_CLICKHOUSE_PORT=18123
NITRO_PORT=3000

# Read after explicit first initialization; normal starts require these identities.
RECOUNT_POSTGRES_DATA_ID=
RECOUNT_KAFKA_DATA_ID=
RECOUNT_CLICKHOUSE_DATA_ID=
RECOUNT_CLICKHOUSE_IMAGE=recount-clickhouse:local
RECOUNT_SCHEMA_DIRECTORY=./.state/clickhouse

RECOUNT_RAW_TOPIC=recount.metrics.raw
RECOUNT_NORMALIZED_TOPIC=recount.metrics.normalized
RECOUNT_RAW_PARTITIONS=3
RECOUNT_NORMALIZED_PARTITIONS=3
RECOUNT_LIVE_TOPIC=recount.metrics.live
RECOUNT_LIVE_PARTITIONS=8
# Generate with: openssl rand -hex 32
RECOUNT_LIVE_GATEWAY_SECRET=
RECOUNT_LIVE_RETENTION_MS=300000
RECOUNT_LIVE_RETENTION_BYTES=16777216
RECOUNT_LIVE_SEGMENT_BYTES=1048576
RECOUNT_LIVE_SEGMENT_MS=60000
RECOUNT_LIVE_BROKER_MAX_BYTES=65536
RECOUNT_NORMALIZER_GROUP=recount-normalizer

# Provisional per-partition development retention, not a recovery guarantee.
RECOUNT_RAW_RETENTION_MS=21600000
RECOUNT_NORMALIZED_RETENTION_MS=21600000
RECOUNT_RAW_RETENTION_BYTES=134217728
RECOUNT_NORMALIZED_RETENTION_BYTES=134217728
RECOUNT_RAW_SEGMENT_BYTES=16777216
RECOUNT_NORMALIZED_SEGMENT_BYTES=16777216
RECOUNT_RAW_SEGMENT_MS=60000
RECOUNT_NORMALIZED_SEGMENT_MS=60000
RECOUNT_RAW_BROKER_MAX_BYTES=6291456
RECOUNT_NORMALIZED_BROKER_MAX_BYTES=2097152
RECOUNT_BROKER_MESSAGE_BYTES=6291456
RECOUNT_BROKER_FETCH_BYTES=6291456
RECOUNT_BROKER_REQUEST_BYTES=8388608
RECOUNT_BROKER_RETENTION_MS=21600000
RECOUNT_BROKER_RETENTION_BYTES=134217728
RECOUNT_BROKER_SEGMENT_BYTES=16777216
RECOUNT_BROKER_SEGMENT_MS=60000

# Application defaults belong to generated binary --help, not this file.
# Optional shared overrides (set the same value for ingestion and normalizer):
# RECOUNT_MAX_REQUEST_BYTES=5242880
# RECOUNT_NORMALIZED_MAX_RECORD_BYTES=1572864
# Normalizer options, including row/concurrency/timeouts, are passed only when set.
# If changing output rows or normalized topic capacity, prepare a matching schema bundle.
# Protocol-wide response override for larger Kafka metadata; prepare the same value.
# RECOUNT_KAFKA_RECEIVE_BYTES=12582912

# With data.binds.yaml only: supply expanded existing absolute directories.
# RECOUNT_POSTGRES_DATA_DIRECTORY=
# RECOUNT_KAFKA_DATA_DIRECTORY=
# RECOUNT_CLICKHOUSE_DATA_DIRECTORY=
# Run any physical-volume identity/mount checks in an ignored local launcher.
# Shared commands never mount, relocate or repair data.
# Ed25519 seed (32 bytes, base64url) that signs collector access tokens.
# Generate one with: openssl rand 32 | basenc --base64url | tr -d =
RECOUNT_COLLECTOR_SIGNING_KEY=
# Public key for the seed above, trusted by the ingestion service. Print it with:
# RECOUNT_COLLECTOR_SIGNING_KEY=... bun apps/web/scripts/collector-public-key.ts
RECOUNT_INGESTION_COLLECTOR_PUBLIC_KEYS=
