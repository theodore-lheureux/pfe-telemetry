set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set dotenv-filename := ".env"

up:
    docker compose up --detach --wait --wait-timeout 90

status:
    docker compose ps --all

stop:
    docker compose stop

# Run after application migrations; the password is read from the environment.
provision-ingestion:
    test -n "${PFE_INGESTION_PASSWORD:?Set PFE_INGESTION_PASSWORD}"
    docker compose exec -T --env PFE_INGESTION_PASSWORD postgres psql --username=pfe --dbname=pfe < ingestion-role.sql

compose +args:
    docker compose "$@"
