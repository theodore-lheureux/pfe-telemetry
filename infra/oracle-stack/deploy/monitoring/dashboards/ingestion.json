{
  "uid": "recount-ingestion",
  "title": "Recount ingestion health",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kafka metrics",
      "description": "Scrape health only. Missing group data is unknown, not zero lag.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"kafka\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Unavailable", "color": "red" },
                "1": { "text": "Scraping", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queued records by stage",
      "description": "Raw records are submissions; normalized records are Kafka messages. Do not add these quantities across stages.",
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{topic=~\"recount[.](metrics[.](raw|normalized|late)|participants)\"} >= 0)",
          "legendFormat": "{{consumergroup}}",
          "instant": true
        }
      ],
      "options": { "colorMode": "none" },
      "fieldConfig": { "defaults": { "noValue": "Unknown", "decimals": 0 } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "ClickHouse CPU quota hit",
      "description": "Share of scheduling periods throttled over two minutes. Missing or stale host samples are unknown.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(recount_clickhouse_cpu_throttled_periods_total[2m]) / (rate(recount_clickhouse_cpu_periods_total[2m]) > 0)) and on() (recount_ingestion_host_source_up{source=\"cpu\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "instant": true
        }
      ],
      "options": { "colorMode": "none" },
      "fieldConfig": {
        "defaults": { "noValue": "Unknown", "unit": "percentunit" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backlog trend by stage",
      "description": "Rising lag identifies the stage where demand exceeds progress.",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{topic=~\"recount[.](metrics[.](raw|normalized|late)|participants)\"} >= 0)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lag by partition",
      "description": "A single rising line can reveal partition skew hidden by totals.",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_lag{topic=~\"recount[.](metrics[.](raw|normalized|late)|participants)\"} >= 0",
          "legendFormat": "{{consumergroup}} / {{partition}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Normalizer · arrival vs committed progress",
      "description": "Raw Kafka records per second, estimated from the slope of offsets over two minutes.",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(deriv(kafka_topic_partition_current_offset{topic=\"recount.metrics.raw\"}[2m]), 0))",
          "legendFormat": "Arriving"
        },
        {
          "refId": "B",
          "expr": "sum(clamp_min(deriv(kafka_consumergroup_current_offset{consumergroup=\"recount-normalizer\",topic=\"recount.metrics.raw\"}[2m]), 0))",
          "legendFormat": "Committed"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ClickHouse · arrival vs committed progress",
      "description": "Kafka messages per second, not telemetry points per second or query freshness.",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (clamp_min(deriv(kafka_topic_partition_current_offset{topic=~\"recount[.]metrics[.](normalized|late)\"}[2m]), 0))",
          "legendFormat": "{{topic}} · arriving"
        },
        {
          "refId": "B",
          "expr": "sum by (topic) (clamp_min(deriv(kafka_consumergroup_current_offset{consumergroup=~\"recount-clickhouse(-late)?\",topic=~\"recount[.]metrics[.](normalized|late)\"}[2m]), 0))",
          "legendFormat": "{{topic}} · committed"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backlog growth by stage",
      "description": "Five-minute slope in Kafka messages per second. Positive values mean the queue is growing; a brief spike is not a sustained backlog.",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (deriv((kafka_consumergroup_lag >= 0)[5m:15s]))",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retained offset headroom · worst partition",
      "description": "Committed offset minus the oldest retained offset on the closest partition. Negative means the checkpoint is behind retained data. Not a time-to-expiry estimate.",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (consumergroup) ((kafka_consumergroup_current_offset >= 0) - on (topic, partition) group_left() kafka_topic_partition_oldest_offset)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ClickHouse CPU quota hit",
      "description": "Percentage of cgroup scheduling periods throttled. This measures how often throttling occurs, not how much CPU time was lost.",
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(recount_clickhouse_cpu_throttled_periods_total[2m]) / (rate(recount_clickhouse_cpu_periods_total[2m]) > 0)) and on() (recount_ingestion_host_source_up{source=\"cpu\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Throttled periods"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Data volume latency",
      "description": "Mean completed read and write request latency on ClickHouse’s data device, including other workloads that share that device.",
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(recount_data_device_read_seconds_total[2m]) / (rate(recount_data_device_reads_total[2m]) > 0)) and on() (recount_ingestion_host_source_up{source=\"disk\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Read"
        },
        {
          "refId": "B",
          "expr": "(rate(recount_data_device_write_seconds_total[2m]) / (rate(recount_data_device_writes_total[2m]) > 0)) and on() (recount_ingestion_host_source_up{source=\"disk\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Write"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "ClickHouse reads · mean latency",
      "description": "All ClickHouse SELECTs, including monitoring. Not dashboard-only latency or a percentile.",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(recount_clickhouse_select_query_seconds_total[2m]) / (rate(recount_clickhouse_select_queries_total[2m]) > 0)) and on() (recount_ingestion_host_source_up{source=\"queries\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Mean SELECT latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "ClickHouse reads · failures",
      "description": "Failed SELECTs per second across ClickHouse, not just dashboard requests.",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(recount_clickhouse_failed_select_queries_total[2m]) and on() (recount_ingestion_host_source_up{source=\"queries\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Failed SELECTs"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Telemetry points written per second",
      "description": "Rows in new metric_points parts over two minutes. Excludes merges, includes possible replayed rows, and is delayed by ClickHouse part-log flushing.",
      "gridPos": { "x": 0, "y": 45, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "recount_clickhouse_points_written_per_second and on() (recount_ingestion_host_source_up{source=\"points\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Points written/s"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Host metric sources",
      "description": "A stopped sampler or a failed source is not evidence of healthy ingestion.",
      "gridPos": { "x": 12, "y": 45, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ingestion-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "recount_ingestion_host_source_up and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45)",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Unavailable", "color": "red" },
                "1": { "text": "Reporting", "color": "green" }
              }
            }
          ]
        }
      }
    }
  ]
}
