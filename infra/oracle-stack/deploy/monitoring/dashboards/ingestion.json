{
  "uid": "recount-ingestion",
  "title": "Recount ingestion health",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kafka scrape",
      "description": "Kafka exporter scrape status.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"kafka\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 22
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queued messages",
      "description": "Total lag across reported partitions.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{topic=~\"recount[.](metrics[.](raw|normalized-packed|late)|participants)\",consumergroup=~\"recount-normalizer|recount-clickhouse(-late|-participants)?\"} >= 0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msgs",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10000
              },
              {
                "color": "red",
                "value": 100000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 22
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Active nodes",
      "description": "Non-revoked nodes seen in the last 60 seconds.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(recount_ingestion_active_nodes) and on() (recount_ingestion_host_source_up{source=\"active_nodes\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 22
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "ClickHouse throttling",
      "description": "CPU periods throttled over the last 2 minutes.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(recount_clickhouse_cpu_throttled_periods_total[2m]) / (rate(recount_clickhouse_cpu_periods_total[2m]) > 0)) and on() (recount_ingestion_host_source_up{source=\"cpu\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.15
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 22
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Write delay p95",
      "description": "API receive to ClickHouse insert; sampled from recent point parts.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(last_over_time(recount_ingestion_freshness_p95_seconds[2m]) and on() (time() - last_over_time(recount_ingestion_freshness_p95_write_timestamp_seconds[2m]) < 120) and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45) and on() (recount_ingestion_host_source_up{source=\"freshness\"} == 1)) or on() ((-1 * (recount_ingestion_freshness_samples >= bool 0)) and on() (recount_ingestion_host_source_up{source=\"freshness\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45)))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "No sample",
                  "color": "gray"
                }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 22
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Points in sample",
      "description": "At least 20 points are needed for p95.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(recount_ingestion_freshness_samples) and on() (recount_ingestion_host_source_up{source=\"freshness\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: pts",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "text": {
          "titleSize": 11,
          "valueSize": 22
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Normalizer lag",
      "description": "Uncommitted messages, stacked by partition.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_lag{consumergroup=\"recount-normalizer\",topic=\"recount.metrics.raw\"} >= 0",
          "legendFormat": "p{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msgs",
          "noValue": "Unknown",
          "custom": {
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "lag"
            }
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "ClickHouse recent lag",
      "description": "Uncommitted messages, stacked by partition.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_lag{consumergroup=\"recount-clickhouse\",topic=\"recount.metrics.normalized-packed\"} >= 0",
          "legendFormat": "p{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msgs",
          "noValue": "Unknown",
          "custom": {
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "lag"
            }
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "ClickHouse late lag",
      "description": "Uncommitted messages by partition; an empty partition has zero lag.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(kafka_consumergroup_lag{consumergroup=\"recount-clickhouse-late\",topic=\"recount.metrics.late\"} >= 0) or on (topic, partition) ((kafka_topic_partition_current_offset{topic=\"recount.metrics.late\"} - kafka_topic_partition_oldest_offset{topic=\"recount.metrics.late\"}) == 0)",
          "legendFormat": "p{{partition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msgs",
          "noValue": "Unknown",
          "custom": {
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "lag"
            }
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Partition lag now",
      "description": "Current lag by topic and partition.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(kafka_consumergroup_lag{topic=~\"recount[.](metrics[.](raw|normalized-packed|late)|participants)\",consumergroup=~\"recount-normalizer|recount-clickhouse(-late|-participants)?\"} >= 0)",
          "legendFormat": "{{topic}} / p{{partition}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msgs",
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Normalizer throughput",
      "description": "Committed Kafka messages per second over 2 minutes.",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (clamp_min(deriv((kafka_consumergroup_current_offset{consumergroup=\"recount-normalizer\",topic=\"recount.metrics.raw\"} >= 0)[2m:15s]), 0))",
          "legendFormat": "Committed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s",
          "noValue": "Unknown"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ClickHouse throughput",
      "description": "Committed Kafka messages per second over 2 minutes.",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (clamp_min(deriv((kafka_consumergroup_current_offset{consumergroup=~\"recount-clickhouse(-late)?\",topic=~\"recount[.]metrics[.](normalized-packed|late)\"} >= 0)[2m:15s]), 0))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s",
          "noValue": "Unknown"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Net backlog change",
      "description": "Arrival minus commits over 5 minutes; orange means growth.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (deriv((kafka_consumergroup_lag{topic=~\"recount[.](metrics[.](raw|normalized-packed|late)|participants)\",consumergroup=~\"recount-normalizer|recount-clickhouse(-late|-participants)?\"} >= 0)[5m:15s]))",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s",
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "scheme",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "orange",
                "value": 1e-6
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retention headroom",
      "description": "Committed offset minus oldest retained offset; worst partition.",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (consumergroup) ((kafka_consumergroup_current_offset{topic=~\"recount[.](metrics[.](raw|normalized-packed|late)|participants)\",consumergroup=~\"recount-normalizer|recount-clickhouse(-late|-participants)?\"} >= 0) - on (topic, partition) group_left() kafka_topic_partition_oldest_offset)",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msgs",
          "noValue": "Unknown"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Points written",
      "description": "Rows inserted into metric_points over 2 minutes.",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(recount_clickhouse_new_rows_per_second{table=\"metric_points\"}) and on() (recount_ingestion_host_source_up{source=\"part_log\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "Points"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: pts/s",
          "noValue": "Unknown"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Container CPU",
      "description": "Cgroup CPU rates summed by service, with individual normalizer replicas shown separately. The dashed line is the ClickHouse limit.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(recount_ingestion_container_cpu_seconds_total[2m]) and recount_ingestion_container_cpu_seconds_total) and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45)",
          "legendFormat": "{{service}}"
        },
        {
          "refId": "B",
          "expr": "(recount_clickhouse_cpu_limit_cores) and on() (recount_ingestion_host_source_up{source=\"cpu\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "ClickHouse limit"
        },
        {
          "refId": "C",
          "expr": "(rate(recount_ingestion_container_cpu_seconds_total{service=\"normalizer\",container!=\"\"}[2m]) and recount_ingestion_container_cpu_seconds_total) and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45)",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "noValue": "Unknown"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ClickHouse limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [6, 4]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Merge CPU",
      "description": "CPU spent on completed merges over 2 minutes.",
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ingestion-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(recount_clickhouse_merge_cpu_seconds_per_second) and on() (recount_ingestion_host_source_up{source=\"part_log\"} == 1 and on() (time() - recount_ingestion_host_sample_timestamp_seconds < 45))",
          "legendFormat": "{{table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cores",
          "noValue": "Unknown"
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
