[Unit]
Description=Recount collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
UMask=0077
StateDirectory=recount-collector
StateDirectoryMode=0700
RuntimeDirectory=recount-collector
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/recount-collector/runtime.env
Environment=RECOUNT_COLLECTOR_VISIBILITY=host
Environment=RECOUNT_COLLECTOR_STATE_DIRECTORY=/var/lib/recount-collector/node
Environment=RECOUNT_COLLECTOR_QUEUE_DIRECTORY=/var/lib/recount-collector/queue
Environment=RECOUNT_COLLECTOR_ENROLLMENT_KEY_FILE=/run/recount-collector/enrollment.key
ExecStartPre=/usr/local/sbin/recount-collector-prepare enroll
ExecStart=/usr/local/bin/recount-collector
ExecStartPost=/bin/sh -c 'while [ ! -f /var/lib/recount-collector/node/node.json ]; do sleep 2; done; rm -f /run/recount-collector/enrollment.key'
Restart=on-failure
RestartSec=75
TimeoutStartSec=180
TimeoutStopSec=60
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/recount-collector /run/recount-collector

[Install]
WantedBy=multi-user.target
