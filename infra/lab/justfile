set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set dotenv-filename := ".env"
set dotenv-load

export VAGRANT_CHECKPOINT_DISABLE := "1"
export ANSIBLE_CONFIG := source_directory() / "ansible/ansible.cfg"
export ANSIBLE_INVENTORY := env("VAGRANT_DOTFILE_PATH", source_directory() / ".vagrant") / "provisioners/ansible/inventory/vagrant_ansible_inventory"

default:
    @just --justfile "{{ justfile() }}" --list lab

# Optional lab dependencies and missing configuration; no provisioning.
setup:
    uv sync --project ../.. --locked
    @if [ ! -e .env ] && [ ! -L .env ]; then (umask 077; set -C; cat .env.example > .env); fi

# Start the application stack separately before verifying ingestion connectivity.
up:
    docker compose up --no-build --detach --wait --wait-timeout 90
    uv run --project ../.. --locked vagrant up --provider=virtualbox --no-parallel
    just --justfile "{{ justfile() }}" lab verify

verify *args:
    uv run --project ../.. --locked ansible-playbook ansible/site.yml --tags verify "$@"

check *args:
    uv run --project ../.. --locked ansible-playbook ansible/site.yml --check --diff --tags all,verify "$@"

inventory +args:
    uv run --project ../.. --locked ansible-inventory --playbook-dir ansible "$@"

provision *nodes:
    uv run --project ../.. --locked vagrant provision "$@"
    just --justfile "{{ justfile() }}" lab verify

# Install the prebuilt collector for each VM architecture.
collectors *args:
    uv run --project ../.. --locked ansible-playbook ansible/collector.yml "$@"

# Run cpu, memory, or io on all nodes or an inventory limit.
workload kind='cpu' seconds='10' nodes='all' *args:
    uv run --project ../.. --locked ansible-playbook ansible/workload.yml --limit "$3" --extra-vars "recount_workload=$1" --extra-vars "recount_duration=$2" "${@:4}"

status:
    uv run --project ../.. --locked vagrant status
    docker compose ps --all

stop:
    uv run --project ../.. --locked vagrant halt
    docker compose stop

# Vagrant asks for confirmation before deleting guest disks.
destroy:
    uv run --project ../.. --locked vagrant destroy
    docker compose down

# Pass native options through, e.g. `just lab vagrant ssh node1`.
vagrant +args:
    uv run --project ../.. --locked vagrant "$@"

compose +args:
    docker compose "$@"

validate:
    uv run --project ../.. --locked vagrant validate
    docker compose config --quiet

syntax:
    ruby -c Vagrantfile
    uv run --project ../.. --locked ansible-playbook --syntax-check --inventory compute, ansible/*.yml
    docker compose --env-file .env.example config --quiet
