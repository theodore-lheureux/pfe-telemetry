[Unit]
Description=Recount collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
Environment={{ ('OTEL_EXPORTER_OTLP_ENDPOINT=' ~ recount_collector_endpoint) | to_json }}
Environment={{ ('RECOUNT_COLLECTOR_HOST_ID=' ~ ansible_facts.hostname) | to_json }}
Environment={{ ('RECOUNT_COLLECTOR_ENROLLMENT_URL=' ~ recount_collector_enrollment_url) | to_json }}
Environment=RECOUNT_COLLECTOR_ENROLLMENT_KEY_FILE=/etc/recount-collector/enrollment.key
Environment=RECOUNT_COLLECTOR_STATE_DIRECTORY=/var/lib/{{ recount_collector_queue_name }}/node
Environment=RECOUNT_COLLECTOR_QUEUE_DIRECTORY=/var/lib/{{ recount_collector_queue_name }}
Environment=RECOUNT_COLLECTOR_INTERVAL_MS={{ recount_collector_interval_ms }}
Environment=RECOUNT_COLLECTOR_VISIBILITY=host
Environment=RECOUNT_COLLECTOR_PROCESS_NAMESPACE_ID=host
ExecStart=/usr/local/bin/recount-collector
StateDirectory={{ recount_collector_queue_name }}
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
MemoryMax=256M
MemorySwapMax=0
TasksMax=64

[Install]
WantedBy=multi-user.target
