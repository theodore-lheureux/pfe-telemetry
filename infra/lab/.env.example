# Stop the environment before changing ports or VM allocations.
RECOUNT_INGESTION_PORT=14317
RECOUNT_LAB_PROMETHEUS_PORT=9090
RECOUNT_LAB_GRAFANA_PORT=3003
RECOUNT_LAB_NODE_CPUS=1
RECOUNT_LAB_NODE_MEMORY_MB=1024
RECOUNT_LAB_VM_PREFIX=recount-lab
# Example /24 addresses only: select a reserved private network locally before up.
RECOUNT_LAB_NODE1_ADDRESS=192.168.56.11
RECOUNT_LAB_NODE2_ADDRESS=192.168.56.12
# For existing VMs, explicitly select their existing metadata before any lifecycle command.
# VAGRANT_DOTFILE_PATH=
# COMPOSE_PROJECT_NAME=
