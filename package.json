{
  "name": "pfe-telemetry",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun --bun run lefthook install",
    "dev": "bun --bun run --filter @pfe/web dev",
    "build": "bun --bun run --filter @pfe/web build",
    "i18n:compile": "bun run --filter @pfe/i18n compile",
    "typecheck": "bun run i18n:compile && bun run --cwd packages/i18n typecheck && bun run --cwd packages/transactional typecheck && bun run --cwd apps/web typecheck",
    "lint": "just lint",
    "lint:fix": "just lint-fix",
    "format": "just format",
    "format:check": "just format-check",
    "check": "just check",
    "hooks:install": "bun --bun run lefthook install",
    "env": "just env"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inlang/paraglide-js": "3.0.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ]
}
