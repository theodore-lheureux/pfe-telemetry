{
  "name": "recount",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/landing",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun --bun run lefthook install",
    "i18n:compile": "bun run --filter @recount/i18n compile",
    "typecheck": "bun run i18n:compile && bun run --cwd packages/i18n typecheck && bun run --cwd packages/transactional tsc --noEmit && bun run --cwd apps/web typecheck && bun run --cwd apps/landing check",
    "hooks:install": "bun --bun run lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@inlang/paraglide-js": "3.0.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ],
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
