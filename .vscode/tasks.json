{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check repository",
      "type": "process",
      "command": "just",
      "args": ["check"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Build web application",
      "type": "process",
      "command": "just",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Test Rust workspace",
      "type": "process",
      "command": "just",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
