{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "ci/*.ts",
    "load/*.ts",
    "runtime/*.ts",
    "tooling/*.ts",
    "linux-artifacts.ts"
  ]
}
