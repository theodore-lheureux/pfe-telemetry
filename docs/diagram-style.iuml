' Shared Recount diagram style.
' Teal boxes are Recount components; white boxes are third-party services.

skinparam dpi 150
skinparam shadowing false
skinparam ResponseMessageBelowArrow true
skinparam defaultFontName SansSerif
skinparam defaultFontColor #0F1B1F
skinparam defaultFontSize 14
skinparam roundCorner 10
skinparam ArrowColor #64767D
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #475A62
skinparam ArrowFontSize 12
skinparam BackgroundColor #FFFFFF

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #C3CFD3
  BorderThickness 1.2
}
skinparam rectangle<<recount>> {
  BackgroundColor #DCEFEC
  BorderColor #0F766E
  BorderThickness 1.6
}
skinparam rectangle<<zone>> {
  BackgroundColor #F5F7F8
  BorderColor #D9E2E5
  BorderStyle plain
  FontColor #475A62
  FontSize 13
  FontStyle bold
  StereotypeFontSize 0
}
skinparam queue {
  BackgroundColor #FFFFFF
  BorderColor #C3CFD3
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #C3CFD3
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #0F1B1F
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #C3CFD3
  FontColor #475A62
  FontSize 12
}

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #C3CFD3
  ParticipantFontSize 14
  LifeLineBorderColor #C3CFD3
  LifeLineBackgroundColor #DCEFEC
  DividerBackgroundColor #F5F7F8
  DividerBorderColor #D9E2E5
  DividerFontColor #0F766E
  DividerFontStyle bold
  DividerFontSize 13
  ActorBorderColor #0F1B1F
  ActorBackgroundColor #FFFFFF
}
skinparam participant<<recount>> {
  BackgroundColor #DCEFEC
  BorderColor #0F766E
}
skinparam queue<<recount>> {
  BackgroundColor #DCEFEC
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #C3CFD3
  HeaderBackgroundColor #FFFFFF
  AttributeFontColor #475A62
  FontStyle bold
}
skinparam class<<recount>> {
  BackgroundColor #DCEFEC
  HeaderBackgroundColor #DCEFEC
  BorderColor #0F766E
}
