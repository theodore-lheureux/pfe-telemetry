@startuml
!pragma teoz true
!include diagram-style.iuml

title Recount - Telemetry flow
skinparam style strictuml
hide footbox

participant "Collector" as collector
participant "Ingestion API" as ingestion
queue "Kafka" as kafka
participant "Normalizer" as normalizer
database "ClickHouse" as clickhouse
participant "Web application" as web
actor "User" as user

== Ingestion ==
collector -> ingestion ++ : OTLP export (node token)
ingestion -> ingestion : Verify token and validate
ingestion -> kafka ++ : Publish raw record
kafka --> ingestion -- : Acknowledged
ingestion --> collector -- : OK
collector -> collector : Remove batch from queue

== Normalization ==
normalizer -> kafka ++ : Read raw records
kafka --> normalizer -- : Raw record
normalizer -> normalizer : Revalidate and split into points
normalizer -> kafka : Publish normalized points
normalizer -> kafka : Commit offset

== Storage ==
clickhouse -> kafka ++ : Kafka engine reads points
kafka --> clickhouse -- : Points
clickhouse -> clickhouse : Insert into metric_points

== Query ==
user -> web ++ : Open dashboard
web -> web : Check project access
web -> clickhouse ++ : Read-only query
clickhouse --> web -- : Rows
web --> user -- : Charts
@enduml
