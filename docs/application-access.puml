@startuml
!include diagram-style.iuml
hide circle
hide methods
hide empty members
skinparam nodesep 50
skinparam ranksep 60

class User
class Organization
class "Organization member" as OrgMember {
  role: owner | admin | member
}
class Project <<recount>>
class "Project grant" as Grant {
  role: viewer | member | admin
}
class "Collector node" as Node <<recount>>
class Dashboard <<recount>>
class "Saved insight" as Insight <<recount>>

User "1" -- "*" OrgMember
Organization "1" -- "*" OrgMember
Organization "1" -- "*" Project
OrgMember "1" -- "*" Grant
Grant "*" -right- "1" Project
Project "1" -- "*" Node
Project "1" -- "*" Dashboard
Project "1" -- "*" Insight
Dashboard "*" -right- "*" Insight : tiles

note left of OrgMember
  Owners and admins administer
  every project in the organization.
end note
note bottom of Grant
  Members see only
  the projects they are granted.
end note

hide stereotype
@enduml
