@startuml
!include diagram-style.iuml

title Recount - Delivery pipeline
skinparam defaultTextAlignment center
skinparam ActivityBarColor #222222

start
:Push to main;
fork
  :Checks
  (lint, types, unit tests);
fork again
  :Integration tests
  (Rust, Kafka, ClickHouse, browser);
fork again
  if (Shipped files changed?) then (yes)
    :Build images
    (amd64, arm64);
    :Attest archive;
    :Approve deployment;
    :Verify attestation;
    :Ansible over SSH
    activates the release;
    :app.recount.cloud updated;
  else (no)
  endif
end fork
stop
@enduml
