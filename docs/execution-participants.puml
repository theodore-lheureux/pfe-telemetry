@startuml
!include diagram-style.iuml
skinparam style strictuml
hide footbox

actor "User" as user
participant "Launcher\nor Slurm" as launcher <<recount>>
participant "Process" as process
participant "Collector" as collector <<recount>>
participant "Ingestion API" as ingestion <<recount>>
queue "Kafka" as kafka
database "ClickHouse" as clickhouse
participant "Web application" as web <<recount>>

== Launch ==
user -> launcher : recount run ~--execution run-42 ~-- cmd
launcher -> process : exec with RECOUNT_EXECUTION=run-42
note over launcher, process : Slurm jobs use slurm:<SLURM_JOB_ID>

== Discovery ==
collector -> process : Read environment once
collector -> collector : Keep only the label
collector -> ingestion ++ : Claim participant
ingestion -> kafka : Publish participant fact
ingestion --> collector -- : OK
collector -> ingestion : Claim process membership
collector -> ingestion : End membership on exit
kafka -> clickhouse : Participant facts

== Viewing ==
user -> web ++ : Open execution run-42
web -> clickhouse ++ : Participants and metrics
clickhouse --> web --
web --> user -- : Execution view

hide stereotype
@enduml
