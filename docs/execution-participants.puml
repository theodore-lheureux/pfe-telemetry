@startuml
!pragma teoz true
!include diagram-style.iuml

title Recount - Execution participants
skinparam style strictuml
hide footbox

actor "User" as user
participant "Launcher\nor Slurm" as launcher
participant "Process" as process
participant "Collector" as collector
participant "Ingestion API" as ingestion
queue "Kafka" as kafka
database "ClickHouse" as clickhouse
participant "Web application" as web

user -> launcher : recount run ~--execution run-42 ~-- cmd
launcher -> process : exec with RECOUNT_EXECUTION=run-42
note right of launcher : Slurm jobs use\nSLURM_JOB_ID → slurm:<id>

collector -> process : Read environment once
collector -> collector : Keep only the execution label

collector -> ingestion ++ : Claim participant lifecycle
ingestion -> kafka : Publish participant fact
ingestion --> collector -- : OK
collector -> ingestion : Claim process membership
collector -> ingestion : End membership when process exits

kafka -> clickhouse : Participant facts

user -> web ++ : Open execution run-42
web -> clickhouse ++ : Participants and their nodes' metrics
clickhouse --> web --
web --> user -- : Execution view
@enduml
