@startuml
!include diagram-style.iuml

title Recount - Architecture
skinparam nodesep 60
skinparam ranksep 60
skinparam defaultTextAlignment left

actor "User" as user

rectangle "Compute nodes" <<zone>> {
  rectangle "<b>Collector</b>\n[Rust]\n\nNode, process and\nGPU (DCGM) metrics" as collector
  rectangle "<b>Launcher</b>\n[recount run]\n\nLabels a command\nwith an execution key" as launcher
}

rectangle "Ingestion" <<zone>> {
  rectangle "<b>Ingestion API</b>\n[Rust / gRPC]\n\nAuthenticates and\nvalidates submissions" as ingestion
  queue "<b>Kafka</b>\n\nRaw, normalized and\nparticipant topics" as kafka
  rectangle "<b>Normalizer</b>\n[Rust]\n\nOne point per record" as normalizer
}

rectangle "Storage" <<zone>> {
  database "<b>ClickHouse</b>\n\nMetric points and\nexecution participants" as clickhouse
  database "<b>PostgreSQL</b>\n\nUsers, organizations,\nprojects, nodes" as postgres
}

rectangle "Application" <<zone>> {
  rectangle "<b>Web application</b>\n[TanStack Start]\n\nInsights, dashboards,\nexecutions, settings" as web
  rectangle "<b>Live gateway</b>\n[Bun]\n\nStreams incoming points" as live
}

launcher -down-> collector : Environment label
collector -right-> ingestion : Metrics and participants\n[OTLP / gRPC, TLS]
collector -down-> web : Enrollment and tokens\n[HTTPS]
ingestion -right-> kafka : Publishes
kafka -down-> normalizer : Raw records
normalizer -up-> kafka : Normalized points
kafka -down-> clickhouse : Kafka engine
ingestion -down-> postgres : Revoked nodes
web -down-> clickhouse : Authorized queries
web -down-> postgres : Sessions and access
live -up-> kafka : Live topic
web -right-> live : Activity feed
user -down-> web : [HTTPS]

hide stereotype
@enduml
