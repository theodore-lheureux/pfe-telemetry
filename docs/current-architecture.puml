@startuml
!include diagram-style.iuml
left to right direction
skinparam nodesep 50
skinparam ranksep 90

rectangle "Compute nodes" <<zone>> {
  rectangle "<b>Launcher</b>\n<i>recount run</i>\n\nLabels a command\nwith an execution key" as launcher <<recount>>
  rectangle "<b>Collector</b>\n<i>Rust</i>\n\nNode, process and\nGPU (DCGM) metrics" as collector <<recount>>
}

rectangle "Ingestion" <<zone>> {
  rectangle "<b>Ingestion API</b>\n<i>Rust · gRPC</i>\n\nAuthenticates and\nvalidates uploads" as ingestion <<recount>>
  queue "<b>Kafka</b>\n\nRaw, normalized and\nparticipant topics" as kafka
  rectangle "<b>Normalizer</b>\n<i>Rust</i>\n\nSplits records\ninto points" as normalizer <<recount>>
}

rectangle "Storage" <<zone>> {
  database "<b>PostgreSQL</b>\n\nUsers, organizations,\nprojects and nodes" as postgres
  database "<b>ClickHouse</b>\n\nMetric points and\nexecution participants" as clickhouse
}

rectangle "Application" <<zone>> {
  rectangle "<b>Web application</b>\n<i>TanStack Start</i>\n\nInsights, dashboards,\nexecutions and settings" as web <<recount>>
  rectangle "<b>Live gateway</b>\n<i>Bun</i>\n\nStreams incoming\npoints" as live <<recount>>
}

actor "User" as user

launcher -> collector : execution label
collector --> ingestion : OTLP over TLS
ingestion -> kafka : raw records
kafka <-> normalizer : records, points
ingestion --> postgres : revoked nodes
kafka --> clickhouse : Kafka engine
kafka ---> live : live topic
postgres <-- web : sessions
clickhouse <-- web : queries
live -> web : activity feed
web <-- user : HTTPS

hide stereotype
@enduml
