@startuml
!pragma teoz true
!include diagram-style.iuml

title Recount - Retry after a timeout
skinparam style strictuml
hide footbox

participant "Collector" as collector
participant "Ingestion API" as ingestion
queue "Kafka" as kafka
participant "Normalizer" as normalizer
database "ClickHouse" as clickhouse

== Initial upload ==
collector -> collector : Persist batch B1
collector -> ingestion ++ : OTLP export (B1)
ingestion -> kafka ++ : Publish B1
kafka --> ingestion -- : Acknowledged
ingestion ->x collector -- : Response lost
collector -> collector : Timeout, keep B1

== Retry ==
collector -> ingestion ++ : OTLP export (B1, same identities)
ingestion -> kafka ++ : Publish B1
kafka --> ingestion -- : Acknowledged
ingestion --> collector -- : OK
collector -> collector : Delete B1

== Storage ==
normalizer -> kafka : Read B1, B1
normalizer -> kafka : Publish points twice
clickhouse -> kafka : Read points
clickhouse -> clickhouse : Same sample identity
clickhouse -> clickhouse : ReplacingMergeTree keeps one row
@enduml
