@startuml
!include diagram-style.iuml
skinparam nodesep 40
skinparam ranksep 45

actor "User" as user

rectangle "AWS" <<zone>> {
  rectangle "<b>recount-collector-first</b>\n\nCollector" as aws1 <<recount>>
  rectangle "<b>recount-collector-second</b>\n\nCollector" as aws2 <<recount>>
}

rectangle "Cloudflare" <<zone>> {
  rectangle "<b>Landing site</b>\n\nrecount.cloud" as landing <<recount>>
}

rectangle "Oracle Cloud VM" <<zone>> {
  rectangle "<b>Caddy</b>\n\napp.recount.cloud\ningest.recount.cloud" as caddy
  rectangle "<b>Web application</b>" as web <<recount>>
  rectangle "<b>Ingestion API</b>" as ingestion <<recount>>
  rectangle "<b>Live gateway</b>" as live <<recount>>
  database "<b>PostgreSQL</b>" as postgres
  database "<b>ClickHouse</b>" as clickhouse
  queue "<b>Kafka</b>" as kafka
  rectangle "<b>Normalizer</b>" as normalizer <<recount>>
}


user -down-> landing
user -down-> caddy
aws1 -down-> caddy : telemetry
aws2 -down-> caddy : telemetry
landing -right-> caddy : session check
caddy -down-> web
caddy -down-> ingestion
web -[hidden]right- ingestion
web -[hidden]down- postgres
ingestion -[hidden]down- kafka
live -[hidden]right- postgres
postgres -[hidden]right- clickhouse
clickhouse -[hidden]right- kafka
kafka -[hidden]right- normalizer

hide stereotype
@enduml
