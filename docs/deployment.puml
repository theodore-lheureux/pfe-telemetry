@startuml
!include diagram-style.iuml

title Recount - Deployment
skinparam nodesep 50
skinparam ranksep 60
skinparam defaultTextAlignment left

actor "User" as user

rectangle "Cloudflare" <<zone>> {
  rectangle "<b>Landing site</b>\n[Astro / Workers]\n\nrecount.cloud" as landing
}

rectangle "Oracle Cloud VM" <<zone>> {
  rectangle "<b>Caddy</b>\n\napp.recount.cloud\ningest.recount.cloud" as caddy
  rectangle "Docker Compose" <<zone>> {
    rectangle "<b>Web application</b>" as web
    rectangle "<b>Live gateway</b>" as live
    rectangle "<b>Ingestion API</b>" as ingestion
    rectangle "<b>Normalizer</b>" as normalizer
    queue "<b>Kafka</b>" as kafka
    database "<b>ClickHouse</b>" as clickhouse
    database "<b>PostgreSQL</b>" as postgres
  }
}

rectangle "AWS" <<zone>> {
  rectangle "<b>recount-collector-first</b>\n\nCollector" as aws1
  rectangle "<b>recount-collector-second</b>\n\nCollector" as aws2
}

rectangle "PostHog" <<zone>> {
  rectangle "<b>Product analytics</b>\n\napi-service.recount.cloud" as posthog
}

user -down-> landing
user -down-> caddy : app.recount.cloud
landing -right-> caddy : Session check
aws1 -up-> caddy : ingest.recount.cloud
aws2 -up-> caddy : ingest.recount.cloud
caddy -down-> web
caddy -down-> ingestion
web -down-> live
web -down-> clickhouse
web -down-> postgres
ingestion -down-> kafka
ingestion -down-> postgres
kafka -right-> normalizer
kafka -down-> clickhouse
live -down-> kafka
landing -down-> posthog
web -down-> posthog

hide stereotype
@enduml
